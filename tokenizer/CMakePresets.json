{
  "version": 3,
  "configurePresets": [
    {
      "name": "asan-ubsan",
      "displayName": "ASan + UBSan with Leak Detection",
      "description": "AddressSanitizer, UndefinedBehaviorSanitizer, and leak detection for GCC",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fsanitize=undefined -fno-sanitize-recover=all -g -O0",
        "CMAKE_C_FLAGS": "-fsanitize=address -fsanitize=undefined -fno-sanitize-recover=all -g -O0",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address -fsanitize=undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address -fsanitize=undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan"
    }
  ],
  "testPresets": [
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1",
        "UBSAN_OPTIONS": "abort_on_error=1"
      }
    }
  ]
}
